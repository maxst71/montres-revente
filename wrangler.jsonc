// Configuration Cloudflare Workers : appli dans public/, API dans worker.js.
// Secrets définis dans le tableau de bord Cloudflare : APP_PASSWORD, EBAY_CLIENT_ID, EBAY_CLIENT_SECRET, TELEGRAM_TOKEN.
{
  "name": "montres-revente",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "MONTRES", "id": "bdedd8dbe878460eb612c50f10dfacc0" }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "keep_vars": true
}
